    {"id": "concept:oak", "type": "Concept", "name": "OaK Architecture (Options and Knowledge)", "attributes": {"definition": "A model-based RL architecture in which (1) all components learn continually, (2) each weight has a meta-learned step-size (online cross-validation), and (3) state+time abstractions are continually created via the FC-STOMP progression; a design-general, experiential, open-ended path to superintelligence.", "confidence": "grounded", "sources": ["https://galtay.github.io/blog/sutton-on-oak-at-rlc-2025/", "https://oaklab.ai/posts/the-oak-architecture"]}},
    {"id": "concept:fcstomp", "type": "Concept", "name": "FC-STOMP progression", "attributes": {"definition": "Feature Construction -> pose a SubTask on a feature -> learn an Option solving it -> learn a Model of the option -> Plan with the model. The five-step loop by which OaK builds temporal abstractions grounded in experience.", "confidence": "grounded", "sources": ["https://neurips.cc/virtual/2025/invited-talk/109601", "https://galtay.github.io/blog/sutton-on-oak-at-rlc-2025/"]}},
    {"id": "concept:bigworld", "type": "Concept", "name": "Big World Hypothesis", "attributes": {"definition": "The agent is orders of magnitude smaller than its environment; it can neither fully perceive world-state nor represent optimal action everywhere, so it must approximate, selectively remember/forget, and continually adapt. Computationally efficient/approximate methods win in big worlds.", "confidence": "grounded", "sources": ["https://openreview.net/forum?id=Sv7DazuCn8"]}},
    {"id": "concept:rewardhyp", "type": "Concept", "name": "Reward Hypothesis", "attributes": {"definition": "All of what we mean by goals and purposes can be well thought of as maximization of expected cumulative scalar reward.", "confidence": "grounded", "sources": ["https://arxiv.org/abs/2212.10420", "http://incompleteideas.net/book/the-book.html"]}},
    {"id": "concept:continual", "type": "Concept", "name": "Continual / batch-size-one online learning", "attributes": {"definition": "Learn one step at a time from a non-stationary experience stream without storing or replaying data; the frozen train-then-deploy paradigm is rejected.", "confidence": "grounded", "sources": ["https://oaklab.ai/mission", "https://www.dwarkesh.com/p/richard-sutton"]}},
    {"id": "concept:plasticity", "type": "Concept", "name": "Loss of plasticity / plasticity preservation", "attributes": {"definition": "Standard deep nets progressively lose the ability to learn under continual training; preserving plasticity (e.g. continual backprop injecting variability) is a prerequisite for lifelong learning.", "confidence": "grounded", "sources": ["https://www.nature.com/articles/s41586-024-07711-7"]}},
    {"id": "concept:stepsize", "type": "Concept", "name": "Per-weight meta-learned step-sizes (IDBD)", "attributes": {"definition": "Each parameter learns its own step-size by meta-gradient / online cross-validation rather than sharing a uniform learning rate — enabling fast, robust credit assignment on noisy streams.", "confidence": "grounded", "sources": ["http://www.incompleteideas.net/publications.html", "https://rlj.cs.umass.edu/2024/papers/Paper111.html"]}},
    {"id": "concept:options", "type": "Concept", "name": "Options / temporal abstraction / GVFs", "attributes": {"definition": "Options = (policy pi, termination gamma) as temporally-extended actions; General Value Functions represent predictive knowledge. Temporal abstraction in planning is the historically under-used half of abstraction OaK targets.", "confidence": "grounded", "sources": ["http://incompleteideas.net/publications.html", "https://arxiv.org/abs/2202.03466"]}},
    {"id": "concept:experience", "type": "Concept", "name": "Experience-first learning (Era of Experience)", "attributes": {"definition": "Agents acquire superhuman ability predominantly from their own streams of experience (interaction + grounded reward), moving beyond the 'era of human data' / imitation of human text.", "confidence": "grounded", "sources": ["https://storage.googleapis.com/deepmind-media/Era-of-Experience%20/The%20Era%20of%20Experience%20Paper.pdf", "https://www.dwarkesh.com/p/richard-sutton"]}},
    {"id": "concept:bitter", "type": "Concept", "name": "The Bitter Lesson", "attributes": {"definition": "Over 70 years, general methods that leverage computation (search + learning) beat methods that build in human knowledge; the latter plateau. Directs OaK away from hand-engineered domain knowledge.", "confidence": "grounded", "sources": ["http://www.incompleteideas.net/IncIdeas/BitterLesson.html"]}},
    {"id": "concept:commonmodel", "type": "Concept", "name": "Common model of the intelligent agent", "attributes": {"definition": "A cross-field (AI, psychology, economics, control, neuroscience) skeleton of a decision-maker: input/output/goal + perception, decision, value, and world-model components — with no domain-specific content.", "confidence": "grounded", "sources": ["https://arxiv.org/abs/2202.13252"]}},
    {"id": "concept:eventdriven", "type": "Concept", "name": "Event-driven nets + 20W trillion-param goal", "attributes": {"definition": "Pairing event-driven neural networks with batch-size-one learning for orders-of-magnitude less compute/energy; 'holy grail' target = a trillion-parameter agent learning+planning in real time on ~20W (human-brain budget).", "confidence": "grounded", "sources": ["https://oaklab.ai/mission"]}},

    {"id": "claim:experience_superint", "type": "Claim", "statement": "Superintelligence can and should arise from an agent's own run-time experience (continual learning), not from design-time human engineering: 'We want AI agents that can discover like we can, not which contain what we have discovered.'", "attributes": {"asserted_by": "paper:oak", "confidence": "grounded", "sources": ["https://galtay.github.io/blog/sutton-on-oak-at-rlc-2025/"]}},
    {"id": "claim:state_time_abstraction", "type": "Claim", "statement": "AGI requires model-based RL that plans with a world model abstract in BOTH state and time; temporal abstraction (options) is the historically missing piece, and options must be discovered so their models are useful for planning.", "attributes": {"asserted_by": "paper:oak", "supported_by": ["paper:rrsubtasks"], "confidence": "grounded", "sources": ["https://arxiv.org/abs/2202.03466", "https://galtay.github.io/blog/sutton-on-oak-at-rlc-2025/"]}},
    {"id": "claim:bigworld", "type": "Claim", "statement": "In realistic problems the agent is orders of magnitude smaller than the world; therefore it must use computationally efficient approximation, selective memory, and perpetual online adaptation — a permanent condition, not a temporary hardware limit.", "attributes": {"asserted_by": "paper:bwh", "confidence": "grounded", "sources": ["https://openreview.net/forum?id=Sv7DazuCn8", "https://x.com/kjaved_/status/1916282240335483343"]}},
    {"id": "claim:reward_enough", "type": "Claim", "statement": "Reward maximization is by itself sufficient to underpin all intelligence (natural and artificial) and provides a suitable basis for AGI.", "attributes": {"asserted_by": "paper:rewardenough", "supported_by": ["paper:settling"], "confidence": "grounded", "sources": ["https://philpapers.org/rec/SILRIE-3"]}},
    {"id": "claim:scalar_not_enough", "type": "Claim", "statement": "A single scalar reward is NOT sufficient; capturing intelligence needs multi-objective / vector-valued rewards. (Direct rebuttal of 'Reward is Enough'.)", "attributes": {"asserted_by": "paper:scalarnot", "contradicts": ["claim:reward_enough"], "confidence": "grounded", "sources": ["https://arxiv.org/abs/2112.15422"]}},
    {"id": "claim:llm_deadend", "type": "Claim", "statement": "LLMs are a dead end for AGI: they model 'what a human would say next,' not a true action-conditioned world model; they lack a goal and cannot learn on the job. Experiential learners will supersede them (another instance of the Bitter Lesson).", "attributes": {"asserted_by": "paper:dwarkesh", "supported_by": ["paper:bitter", "paper:eraexp"], "confidence": "grounded", "sources": ["https://www.dwarkesh.com/p/richard-sutton"]}},
    {"id": "claim:llm_useful_prior", "type": "Claim", "statement": "COUNTER (Dwarkesh): pretrained LLMs can serve as a convenient, plentiful prior/intermediary on which experiential learning is layered — non-renewable does not mean dead-end (the 'fossil fuels' analogy).", "attributes": {"asserted_by": "paper:dwarkesh", "contradicts": ["claim:llm_deadend"], "confidence": "grounded", "sources": ["https://www.dwarkesh.com/p/thoughts-on-sutton"]}},
    {"id": "claim:era_experience", "type": "Claim", "statement": "A new generation of agents will acquire superhuman capabilities by learning predominantly from their own experience streams, ending the 'era of human data.'", "attributes": {"asserted_by": "paper:eraexp", "confidence": "grounded", "sources": ["https://storage.googleapis.com/deepmind-media/Era-of-Experience%20/The%20Era%20of%20Experience%20Paper.pdf"]}},
    {"id": "claim:plasticity_prereq", "type": "Claim", "statement": "Standard deep learning loses plasticity under continual learning until it learns no better than a shallow net; sustained lifelong learning requires a continual, partly-random source of variability (e.g. continual backprop). This is a precondition for OaK's 'all components learn continually.'", "attributes": {"asserted_by": "paper:plasticity", "confidence": "grounded", "sources": ["https://www.nature.com/articles/s41586-024-07711-7"]}},
    {"id": "claim:stepsize_meta", "type": "Claim", "statement": "Fast, robust learning on noisy streams needs per-weight meta-learned step-sizes (IDBD / online cross-validation) rather than uniform credit assignment.", "attributes": {"asserted_by": "paper:idbd", "supported_by": ["paper:swifttd", "paper:stepsize"], "confidence": "grounded", "sources": ["https://rlj.cs.umass.edu/2024/papers/Paper111.html", "http://www.incompleteideas.net/publications.html"]}},
    {"id": "claim:efficiency_moat", "type": "Claim", "statement": "The endgame is a trillion-parameter agent that learns and plans in real time on ~20W via event-driven nets + batch-size-one learning — using orders of magnitude less compute/energy than current methods.", "attributes": {"asserted_by": "paper:oak", "confidence": "grounded", "sources": ["https://oaklab.ai/mission"]}},
    {"id": "claim:bitter", "type": "Claim", "statement": "General methods that leverage computation (search + learning) ultimately beat human-knowledge-engineered methods by a large margin.", "attributes": {"asserted_by": "paper:bitter", "confidence": "grounded", "sources": ["http://www.incompleteideas.net/IncIdeas/BitterLesson.html"]}},
    {"id": "claim:three_dogmas", "type": "Claim", "statement": "RL rests on three questionable 'dogmas' (environment as a single stationary MDP-like object, reward as an adequate scalar signal, and an evaluation-first stance); rethinking them is needed for continual, big-world agents.", "attributes": {"asserted_by": "paper:dogmas", "confidence": "hypothesis", "sources": ["https://rlj.cs.umass.edu/2024/papers/RLJ_RLC_2024_89.pdf"]}}
  ],
